{
  "name": "hono-better-auth",
  "scripts": {
    "dev": "bun run --hot src/index.ts",
    "db:generate:migration": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:studio": "drizzle-kit studio",
    "db:seed": "bun run ./scripts/seed.script.ts",
    "db:reset": "bun run ./scripts/reset.script.ts",
    "lint": "bunx eslint . --ext .ts,.tsx",
    "console": "DATABASE_URL=postgresql://user:password@localhost:5432/todos tsx ./scripts/console.script.ts",
    "open-auth-docs": "open-cli http://localhost:3000/api/auth/reference"
  },
  "dependencies": {
    "@hono/zod-validator": "^0.7.0",
    "better-auth": "^1.2.12",
    "drizzle-orm": "^0.44.2",
    "drizzle-seed": "^0.3.1",
    "form-data": "^4.0.3",
    "hono": "^4.8.3",
    "mailgun.js": "^12.0.3",
    "pg": "^8.16.2",
    "zod": "^3.25.67"
  },
  "devDependencies": {
    "@eslint/js": "^9.28.0",
    "@hono/node-server": "^1.14.4",
    "@types/bun": "latest",
    "@types/pg": "^8.15.4",
    "@typescript-eslint/eslint-plugin": "^8.34.0",
    "@typescript-eslint/parser": "^8.34.0",
    "drizzle-kit": "^0.31.1",
    "eslint": "^9.28.0",
    "globals": "^16.2.0",
    "open-cli": "^8.0.0",
    "tsx": "^4.20.3",
    "typescript-eslint": "^8.34.0"
  }
}
